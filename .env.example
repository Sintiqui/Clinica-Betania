# ARCHIVO: .env.example
# PAPEL: plantilla del .env SIN claves reales
# USO: copiar como .env y llenar los valores

# Correo de Gmail que envia los mensajes
GMAIL_USUARIO=
# Contrasena de aplicacion de Gmail (16 letras, se crea en la cuenta de Google)
GMAIL_CLAVE_APLICACION=

# Puerto del servidor
PORT=3000